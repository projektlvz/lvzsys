-# Show Reviews, Recepis and News menu items.
- if params[:listings] || params[:tags] || params[:simple_search]
  - css_class = 'active'
- else
  - css_class = 'inactive'

%li{:class => 'dropdown ' + css_class}
  %a.dropdown-toggle{:href => popular_path, 'data-target' => '#', 'data-toggle' => 'dropdown'}
    =:blogs.l
    %b.caret
  %ul.dropdown-menu
    %li
      = link_to :reviews.l, '/categories/reviews?tags=Review'
    %li.divider{role: "separator"}
    %li
      = link_to :recepies.l, '/categories/recipes?tags=Recipe'
    %li.divider{role: "separator"}
    %li
      = link_to :news.l, '/categories/blog_post?listings=true'