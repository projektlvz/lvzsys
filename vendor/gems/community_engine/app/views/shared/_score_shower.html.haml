-if score.present?
  - score_picture = nil
  - score_name = nil
  - case true
    - when score >= 11 && score < 101
      - score_picture = 'beginner.jpg'
      - score_name = 'Beginner'
    - when score >= 101 && score < 251
      - score_picture = 'intermediate_member.jpg'
      - score_name = 'Intermediate member'
    - when score >= 251 && score < 501
      - score_picture = 'expert.jpg'
      - score_name = 'Expert'
    - when score >= 501 && score < 1001
      - score_picture = 'gold_member.png'
      - score_name = 'Gold member'
    - when score >= 1001
      - score_picture = 'platinum_member.jpg'
      - score_name = 'Platinum member'
  %div{style: 'min-height: 50px; margin-top: 1px; padding-top: 9%; background-color:white ;color: #ffc107; padding-left: 5px;padding-right: 5px;font-size: 18px;font-weight: 500; line-height: 1.1;', 'data-toggle'=>"tooltip", title: score_name}
    %span
      = "#{score} points"
      - if score_picture.present?
        = image_tag(score_picture, size: "30x30", alt: "Rate")
  %script
    $(document).ready(function(){$('[data-toggle="tooltip"]').tooltip();});

