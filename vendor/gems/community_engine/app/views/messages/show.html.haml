-if @message_thread
  -@page_title = @message_thread.parent_message.sender.login + ':' + @message_thread.parent_message.subject
-else
  -@page_title= @message.subject

=render :partial => 'messages/sidebar_nav'

-if @message_thread.parent_message && @message_thread.parent_message.severity.present?
  %div
    %h3
      = "#{:severity.l} #{@message_thread.parent_message.severity}"

-if @message_thread.parent_message && @message_thread.parent_message.meeting_time.present?
  %div
    %h3
      = "#{:meeting_time.l} #{@message_thread.parent_message.meeting_time}"

-unless @message_thread
  .right= h I18n.l(@message.created_at, :format => :literal_date)
  %pre.clear.message_body= auto_link @message.body
-else
  .right= h I18n.l(@message_thread.parent_message.created_at, :format => :literal_date)
  %pre.clear.message_body= auto_link @message_thread.parent_message.body

  - children = @message_thread.parent_message.children
  - children.each do |child|      
    .right=h I18n.l(child.created_at, :format => :literal_date)
    %em
      =child.sender.login
      \:
    %br
    %pre.message_body= auto_link child.body
    %br
      
-if @reply    
  %ul.list-unstyled
    %li.sent= link_to :reply.l, new_user_message_path(@user, :reply_to => @message), :onclick => "$('#reply').toggle(); $('#message_body').focus(); $('.sent').toggle(); return false;"

  #reply{:style => "display:none;"}=render :partial => 'form_reply', :locals => {:message => @reply, :user => @user}
