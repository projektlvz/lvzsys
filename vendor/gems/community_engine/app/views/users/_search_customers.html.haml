%div{style: 'background-color: gray; color: white; border-radius: 10px; padding: 5px; margin: 5px;'}
  = form_tag("/users", method: "get") do
    .row
      - User.allowed_tags_list.each_slice(4) do |slice|
        .col-sm-4
          - slice.each do |tag|
            %div.checkbox
              %label
                %input{type: "checkbox", id: "cust_#{tag[0]}", name: "cust_tagz_#{tag[1]}", checked: search_params["cust_tagz_#{tag[1]}"] == 'on'}
                = tag[1]
    .row{style: 'padding-top: 5px;'}
      .col-sm-10
        .form-group
          %input{type: "text", class: "form-control", id: "cust_city", name: "cust_city", placeholder: :select_city.l, style: 'width: 240px;', value: search_params['cust_city']}
      .col-sm-2
        = hidden_field_tag(:customers, true)
        = submit_tag(:search.l, class: "btn btn-default")
