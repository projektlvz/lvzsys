%div{style: 'background-color: gray; color: white; border-radius: 10px; padding: 5px; margin: 5px;'}
  .row
    .col-sm-4
      .form-group
        %label{for: "shop_category"}
          = :shop_category.l
        %select.form-control{id: "s_shop_category", style: 'width: 240px;'}
          %option{value: "bakery_shop"}
            = :bakery_shop.l
          %option{value: "farm_shop"}
            = :farm_shop.l
    - Shop.features_list.each_slice(3) do |slice|
      .col-sm-4{style: 'padding-bottom: 5px;'}
        - slice.each do |feature|
          %div.checkbox
            %label
              %input{type: "checkbox", id: "s_#{feature[0]}"}
              = feature[1]
  .row
    .col-sm-10
      .form-group
        %input{type: "text", class: "form-control", id: "s_city", placeholder: :select_city.l, style: 'width: 240px;'}
    .col-sm-2
      %button{type:"button", class:"btn btn-default"}
        = :search.l


