%div{style: 'background-color: gray; color: white; border-radius: 10px; padding: 5px; margin: 5px;'}
  = form_tag("/users", method: "get") do
    .row
      .col-sm-4
        .form-group
          %label{for: "shop_category"}
            = :shop_category.l
          %select.form-control{id: "s_shop_category", name: "s_shop_category", style: 'width: 240px;', onchange: "RetrieveShops()"}
            %option{value: ""}
            %option{value: "bakery_shop"}
              = :bakery_shop.l
            %option{value: "farm_shop"}
              = :farm_shop.l
      - Shop.features_list.each_slice(3) do |slice|
        .col-sm-4
          - slice.each do |feature|
            %div.checkbox
              %label
                %input{type: "checkbox", id: "s_#{feature[0]}", name: "s_features_#{feature[0]}", onchange: "RetrieveShops()"}
                = feature[1]
    .row{style: 'padding-top: 5px;'}
      .col-sm-10
        .form-group
          %input{type: "text", class: "form-control", id: "s_city", name: "s_city", placeholder: :select_city.l, style: 'width: 240px;', onchange: "RetrieveShops()"}
      .col-sm-2
        = submit_tag(:search.l, class: "btn btn-default")
