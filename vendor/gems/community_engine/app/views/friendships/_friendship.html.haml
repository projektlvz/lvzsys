%li
  - user = friendship.friend
  
  = image_tag( user.avatar_photo_url(:medium))
   
  %h3= link_to user.login, user_path(user)
  - if user.metro_area      
    %p= "#{:from.l} #{user.location}"
  %p= friendship.friendship_status.name.l
  %p
    = :requested.l
    = time_ago_in_words friendship.created_at

  - if @is_current_user
    = friendship_control_links(friendship)
    %ul.list-unstyled
      %li.compose= link_to(:send_me_a_message.l, new_user_message_path(@current_user, :to=>user))
      %li.compose= link_to(:send_me_a_collaboration.l, new_user_message_path(@current_user, :to=>user)) if !friendship.friend_customer