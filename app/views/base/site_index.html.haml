-# Fetch google map from a cdn.
%script{:src  => "//maps.google.com/maps/api/js?key=#{ENV.fetch('GOOGLE_MAPS_API_KEY')}"}
%script{:src  => "//cdn.rawgit.com/mahnunchik/markerclustererplus/master/dist/markerclusterer.min.js"}
= javascript_include_tag 'gmaps_google'
= javascript_include_tag 'underscore'
= javascript_include_tag 'custom_map'
= stylesheet_link_tag 'spinner'

- @page_title = configatron.community_name + ' ' + :home.l
- @meta = { :description => configatron.meta_description, :keywords => configatron.meta_keywords, :robots => configatron.robots_meta_list_content }

-unless logged_in?
  =render :partial => 'base/homepage_banner_message'

-# Spinner placeholder for map. Used before the map is ready.
%div.spinner{id: 'map_spinner'}
  %div{:id => 'map', :style => 'height: 400px; border-radius: 10px;'}
  .double-bounce1
  .double-bounce2
%div
  = render :partial => 'base/map_filters'

-box :class => "hfeed" do 
  %h2
    =:recent_posts.l
  %h3
    =link_to fa_icon('plus-circle', :text => :see_all_recent_posts.l), recent_path
  = render :partial => 'posts/post', :collection => @posts
-if show_footer_content? && current_user.present?
  .row#footer-content
    = image_tag 'spinner.gif', :plugin => 'community_engine'
    =:loading_recent_content.l